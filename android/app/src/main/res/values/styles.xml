<resources>

    <!-- Native launch theme. Use only the transparent foreground artwork so
         Android does not draw the launcher adaptive-icon background/mask. -->
    <style name="AppTheme.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/red</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>

        <!-- STATUS BAR -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/red</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- KHÔNG override style "Theme.FullScreenDialog" ở đây. Đó là theme nội bộ
         của React Native cho MỌI <Modal>; resource của app thắng resource của
         library nên đặt windowBackground khác @android:color/transparent sẽ làm
         tất cả modal `transparent` (bottom sheet, dialog mờ...) mất nền trong
         suốt và che hết view phía sau.
         Vệt đỏ status bar lúc mở fullscreen camera được xử lý ở JS bằng
         StatusBar.setBackgroundColor("#000") — xem CameraList/CameraListGrid. -->
</resources>
